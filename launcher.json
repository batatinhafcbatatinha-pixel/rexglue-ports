{
 "recomp": "rexglue-ports",
 "repo": "batatinhafcbatatinha-pixel/rexglue-ports",
 "branch": "main",
 "games_dir": "games",
 "setup": "tools/port-installer/setup/setup.ps1",
 "tools_dir": ".local/tools",
 "deps": {
  "buildtools_gb": 7,
  "python_gb": 0.1,
  "tools": [
   {
    "id": "llvm",
    "name": "LLVM / Clang 22.1.2",
    "check": ".local/tools/llvm-22.1.2/bin/clang++.exe",
    "gb": 3.0
   },
   {
    "id": "cmake",
    "name": "CMake 3.31.12",
    "check": ".local/tools/cmake-3.31.12/bin/cmake.exe",
    "gb": 0.1
   },
   {
    "id": "ninja",
    "name": "Ninja 1.13.2",
    "check": ".local/tools/ninja-1.13.2/ninja.exe",
    "gb": 0.01
   }
  ]
 },
 "groups": [],
 "generic": {
  "play": "Play.cmd",
  "play_cmd": "@echo off\r\nrem Starts this game (built by the launcher with tools/x360port).\r\npython \"%~dp0..\\..\\..\\tools\\x360port\\x360port.py\" play --port \"%~dp0.\" %*\r\nexit /b %errorlevel%\r\n",
  "exe": "build/game.exe",
  "disk_gb": 15,
  "download_gb": 1,
  "minutes": "15-60",
  "tools": [
   "llvm",
   "cmake",
   "ninja"
  ],
  "gb_per_job": 2,
  "steps": [
   {
    "name": "Translate your game (ReXGlue)",
    "run": [
     "{python}",
     "../../../tools/x360port/x360port.py",
     "prepare",
     "--port",
     "{root}"
    ],
    "done_if": "build/codegen-complete.json",
    "prepare": true
   },
   {
    "name": "Compile",
    "run": [
     "{python}",
     "../../../tools/x360port/x360port.py",
     "compile",
     "--port",
     "{root}",
     "--jobs",
     "{jobs}"
    ],
    "retry_if": "build/build.ninja"
   }
  ],
  "buildtools": false,
  "settings": {
   "ini": "pc-settings.ini",
   "section": "video",
   "pc_menu": false,
   "groups": [
    {
     "pt": "Vídeo",
     "en": "Video",
     "items": [
      {
       "key": "resolution_scale",
       "pt": "Resolução interna",
       "en": "Internal resolution",
       "default": 1,
       "restart": true,
       "help_pt": "Desenha o jogo em mais pixels. 3x é 4K; pede uma GPU forte.",
       "help_en": "Draws the game with more pixels. 3x is 4K; it needs a strong GPU.",
       "choices": [
        {
         "v": 1,
         "pt": "Original (720p)",
         "en": "Original (720p)"
        },
        {
         "v": 2,
         "pt": "2x (1440p)",
         "en": "2x (1440p)"
        },
        {
         "v": 3,
         "pt": "3x (2160p, 4K)",
         "en": "3x (2160p, 4K)"
        }
       ]
      },
      {
       "key": "post_effect",
       "pt": "Anti-serrilhado",
       "en": "Anti-aliasing",
       "default": 0,
       "restart": true,
       "choices": [
        {
         "v": 0,
         "pt": "Desligado",
         "en": "Off",
         "word": "none"
        },
        {
         "v": 1,
         "pt": "FXAA",
         "en": "FXAA",
         "word": "fxaa"
        },
        {
         "v": 2,
         "pt": "FXAA extremo",
         "en": "FXAA extreme",
         "word": "fxaa_extreme"
        }
       ]
      },
      {
       "key": "vsync",
       "pt": "Sincronia vertical (vsync)",
       "en": "Vertical sync (vsync)",
       "default": 1,
       "restart": true,
       "choices": [
        {
         "v": 0,
         "pt": "Desligado",
         "en": "Off"
        },
        {
         "v": 1,
         "pt": "Ligado",
         "en": "On"
        }
       ]
      },
      {
       "key": "letterbox",
       "pt": "Proporção",
       "en": "Aspect",
       "default": 1,
       "restart": true,
       "help_pt": "Esticar preenche telas ultrawide.",
       "help_en": "Stretching fills ultrawide screens.",
       "choices": [
        {
         "v": 1,
         "pt": "16:9 com faixas",
         "en": "16:9 with bars"
        },
        {
         "v": 0,
         "pt": "Esticar na janela",
         "en": "Stretch to the window"
        }
       ]
      },
      {
       "key": "anisotropic",
       "pt": "Filtro anisotrópico",
       "en": "Anisotropic filtering",
       "default": -1,
       "restart": true,
       "choices": [
        {
         "v": -1,
         "pt": "O do jogo",
         "en": "The game's"
        },
        {
         "v": 1,
         "pt": "2x",
         "en": "2x"
        },
        {
         "v": 2,
         "pt": "4x",
         "en": "4x"
        },
        {
         "v": 3,
         "pt": "8x",
         "en": "8x"
        },
        {
         "v": 5,
         "pt": "16x",
         "en": "16x"
        }
       ]
      },
      {
       "key": "gpu",
       "pt": "Placa de vídeo",
       "en": "Graphics card",
       "default": -1,
       "restart": true,
       "source": "gpus",
       "help_pt": "Em notebooks com duas, escolha a dedicada.",
       "help_en": "On laptops with two, pick the dedicated one."
      },
      {
       "key": "api",
       "pt": "API gráfica",
       "en": "Graphics API",
       "default": 0,
       "restart": true,
       "help_pt": "Vulkan usa o renderizador Vulkan do próprio runtime (na primeira vez a instalação compila o SDK com ele; demora). Sem placa com Vulkan, fica o Direct3D 12.",
       "help_en": "Vulkan uses the runtime's own Vulkan renderer (the first time, setup builds the SDK with it; it takes a while). Without a Vulkan card, Direct3D 12 stays.",
       "choices": [
        {
         "v": 0,
         "pt": "Direct3D 12 (nativa)",
         "en": "Direct3D 12 (native)",
         "word": "native"
        },
        {
         "v": 1,
         "pt": "Vulkan",
         "en": "Vulkan",
         "word": "vulkan"
        }
       ]
      }
     ]
    }
   ]
  }
 },
 "generic_label": "^[0-9A-F]{8}$"
}
