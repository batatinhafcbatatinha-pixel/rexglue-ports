{
  "game": "Madagascar 3: The Video Game",
  "disc": "Xbox 360",
  "play": "Play-Madagascar3.cmd",
  "disk_gb": 12,
  "download_gb": 1,
  "minutes": "20-60",
  "tools": [
    "llvm",
    "cmake",
    "ninja"
  ],
  "gb_per_job": 2,
  "steps": [
    {
      "name": "Translate the game code and compile",
      "run": [
        "{python}",
        "tools/build_local.py",
        "--game-files",
        "{game_files}",
        "--llvm-dir",
        "{llvm}",
        "--jobs",
        "{jobs}"
      ],
      "reuse_if": ".local/generation-complete.json",
      "reuse_arg": "--reuse-generated",
      "retry_if": ".local/build/build.ninja"
    }
  ],
  "submodules": {
    "../../tools/port-installer": {
      "url": "https://github.com/batatinhafcbatatinha-pixel/port-installer.git",
      "commit": "7c3b4ad5d353cf4609d1c00ab96168a3d16e084f"
    }
  }
}
